# Public catalog/order services stay LOCAL; no remote checkout/PDV in this sprint.
VITE_BACKEND_MODE=local
# Existing preparation only; not a switch for order services.
# VITE_SUPABASE_URL=https://yzxsuoxthkbzbkcumauz.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Auth is opt-in. Set BOTH modes to supabase only in an approved test environment.
VITE_AUTH_MODE=demo
AUTH_MODE=demo
# Server Auth target: local or vila-rica-dev. Hosted target is fixed to the owner's project.
AUTH_TARGET=vila-rica-dev
# Server-only configuration; use ONLY the publishable key, never service_role/secret keys.
# SUPABASE_URL=https://yzxsuoxthkbzbkcumauz.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
# Local-only tests: AUTH_TARGET=local; SUPABASE_URL=http://127.0.0.1:54321
# Local Auth may use its anon key; never place local service_role in app env or VITE_*.
VITE_STAFF_MANAGEMENT_ENABLED=false
STAFF_MANAGEMENT_ENABLED=false
# These flags gate the app UI/endpoints, not RLS. DB RPCs authorize by verified profile.
# Invitations, remote migrations and first-admin bootstrap require separate owner approval.
